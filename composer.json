{
    "name": "request-labs/steward-laravel",
    "description": "Steward by Request agent for Laravel sites: reports installed package versions and drift from composer.lock. Read-only.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^9.21|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.21|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.21|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Request\\StewardLaravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Request\\StewardLaravel\\StewardServiceProvider"
            ]
        }
    }
}
